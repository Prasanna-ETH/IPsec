# OMEGA Backend Environment Variables
# Copy this file to .env for local development

PROJECT_NAME=OMEGA
VERSION=1.0.0-SOVEREIGN
AIR_GAPPED=false

# CORS origins - JSON array string
# For local dev:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# For Render production, set this in Render dashboard:
# CORS_ORIGINS=["https://omega-ipsec.vercel.app"]
